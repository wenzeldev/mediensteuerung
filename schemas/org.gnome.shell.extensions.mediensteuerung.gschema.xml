<schemalist>
  <schema id="org.gnome.shell.extensions.mediensteuerung" path="/org/gnome/shell/extensions/mediensteuerung/">
    <key name="animation-style" type="s">
      <choices>
        <choice value="scope"/>
        <choice value="rider"/>
        <choice value="star"/>
        <choice value="jelly"/>
        <choice value="moth"/>
        <choice value="train"/>
        <choice value="koi"/>
        <choice value="portal"/>
        <choice value="mushroom"/>
        <choice value="skull"/>
        <choice value="astronaut"/>
        <choice value="dragon"/>
        <choice value="pixel-rain"/>
        <choice value="moire"/>
        <choice value="eclipse"/>
        <choice value="segment-meter"/>
        <choice value="square-wave"/>
        <choice value="satellite-orbit"/>
        <choice value="rocket-launch"/>
        <choice value="asteroid-pass"/>
        <choice value="reef-crab"/>
        <choice value="cat-eyes"/>
        <choice value="frog-jump"/>
